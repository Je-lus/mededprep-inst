{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "server.ts",
    "app.ts",
    "lib/**/*.ts",
    "routes/**/*.ts",
    "middleware/**/*.ts",
    "scripts/**/*.ts",
    "prisma/seed.ts",
    "types/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "app", "dist", "prisma/migrations"]
}
