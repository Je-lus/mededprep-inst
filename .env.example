# Required
# Database connection string for production.
DATABASE_URL="postgresql://POSTGRES_USER:POSTGRES_PASSWORD@HOST:PORT/DB_NAME"
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32" # Generate with `openssl rand -hex 32`
NODE_ENV=production
PORT=9001

# Application
# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:9000
# Public-facing URL used in notifications and links.
APP_BASE_URL=https://app.example.com

# Development Only
# DEV_ORG_SLUG allows overriding subdomain detection; remove in production.
DEV_ORG_SLUG=demo

# Optional
# Controls log verbosity (debug, info, warn, error).
LOG_LEVEL=info
IMAGEKIT_PUBLIC_KEY=your_public_key_here
IMAGEKIT_PRIVATE_KEY=your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
